{
  "manifest_version": 3,
  "name": "MitID Auto Authenticator",
  "version": "0.2.0",
  "description": "Approves MitID pre-production Login requests for your test Identities.",
  "permissions": ["storage", "clipboardWrite", "scripting"],
  "host_permissions": ["https://*.pp.mitid.dk/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://netseidbroker.pp.mitid.dk/*"],
      "js": ["loginPanelLoader.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["loginPanel.js", "messages.js", "status.js", "store.js"],
      "matches": ["https://netseidbroker.pp.mitid.dk/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "MitID Auto Authenticator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
